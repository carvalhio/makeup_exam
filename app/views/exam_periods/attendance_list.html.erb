<h1 class="mb-3">Lista de Frequência - 2ª Chamada</h1>

<p class="text-muted mb-3">
  <strong>Período:</strong> <%= @exam_period.name %>
</p>

<%= button_tag "Imprimir",
    type: "button",
    onclick: "window.print()",
    class: "btn btn-primary mb-3 no-print" %>

<!-- MANHÃ -->

<h3 class="mt-4 mb-3">MANHÃ</h3>

<% @morning_subjects.sort_by { |subject, _| subject.code }.each do |subject, items| %>

<div class="subject-container">

  <h4 class="subject-header">
    <%= subject.name %>
  </h4>
  

  <table class="table table-bordered table-sm attendance-table">
    <thead>
      <tr>
        <th style="width: 8%">Turma</th>
        <th style="width: 40%">Aluno</th>
        <th style="width: 52%">Assinatura</th>
      </tr>
    </thead>

    <tbody>

      <% items.each do |item| %>

        <tr>
          <td>
            <%= "#{item[:school_class].grade} #{item[:school_class].identifier}" %>
          </td>

          <td>
            <%= item[:student].name %>
          </td>

          <td></td>
        </tr>

      <% end %>

    </tbody>
  </table>
</div>
<% end %>

<hr class="my-5">

<!-- TARDE -->

<h3 class="mt-4 mb-3">TARDE</h3>

<% @afternoon_subjects.sort_by { |subject, _| subject.code }.each do |subject, items| %>

  <div class="subject-container">

  <h4 class="subject-header">
    <%= subject.name %>
  </h4>

  <table class="table table-bordered table-sm attendance-table">
    <thead>
      <tr>
        <th style="width: 8%">Turma</th>
        <th style="width: 40%">Aluno</th>
        <th style="width: 52%">Assinatura</th>
      </tr>
    </thead>

    <tbody>

     <% items.each do |item| %>

        <tr>
          <td>
            <%= "#{item[:school_class].grade} #{item[:school_class].identifier}" %>
          </td>

          <td>
            <%= item[:student].name %>
          </td>

          <td></td>
        </tr>

      <% end %>

    </tbody>
  </table>
</div>

<% end %>