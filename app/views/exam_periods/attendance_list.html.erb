<h1 class="mb-3">Lista de Frequência - 2ª Chamada</h1>

<p class="text-muted mb-3">
  <strong>Período:</strong> <%= @exam_period.name %>
</p>

<%= button_tag "Imprimir",
    type: "button",
    onclick: "window.print()",
    class: "btn btn-primary mb-3 no-print" %>

<!-- MANHÃ -->
<div class="mb-5">

  <h4 class="fw-bold">MANHÃ</h4>
  <p class="text-muted">Alunos que farão prova pela manhã</p>

  <table class="table table-bordered table-sm align-middle">
    <thead>
      <tr>
        <th style="width: 20%;">Turma</th>
        <th style="width: 40%;">Aluno</th>
        <th style="width: 20%;">Disciplinas</th>
        <th style="width: 20%; height: 60px;">Assinatura</th>
      </tr>
    </thead>

    <tbody>
      <% @morning_requests.each do |request| %>
        <tr>
          <td>
            <%= "#{request.student.school_class.grade} #{request.student.school_class.identifier}" %>
          </td>

          <td>
            <%= request.student.name %>
          </td>

          <td>
            <%= request.subjects.map(&:code).join(", ") %>
          </td>

          <td style="height: 50px;"></td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>

<!-- TARDE -->
<div class="mb-5">

  <h4 class="fw-bold">TARDE</h4>
  <p class="text-muted">Alunos que farão prova pela tarde</p>

  <table class="table table-bordered table-sm exam-table">
    <thead>
      <tr>
        <th style="width: 10%;">Turma</th>
        <th style="width: 20%;">Aluno</th>
        <th style="width: 10%;">Disciplinas</th>
        <th style="width: 10%; height: 60px;">Assinatura</th>
      </tr>
    </thead>

    <tbody>
      <% @afternoon_requests.each do |request| %>
        <tr>
          <td>
            <%= "#{request.student.school_class.grade} #{request.student.school_class.identifier}" %>
          </td>

          <td>
            <%= request.student.name %>
          </td>

          <td>
            <%= request.subjects.map(&:code).join(", ") %>
          </td>

          <td style="height: 50px;"></td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>