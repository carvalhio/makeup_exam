<div class="report-header">

  <h2>LISTA DE FREQUÊNCIA</h2>

  <h3>2ª CHAMADA</h3>

  <p>
    <strong><%= @exam_period.name %> - 
            <%= @exam_period.year %> 
    </strong>
    
  </p>

</div>

 
  <% unless request.format.pdf? %>

  <%= link_to "Download",
      attendance_list_exam_period_path(
        @exam_period,
        format: :pdf
      ),
      class: "btn btn-success mb-3" %>

  <% end %>

<!-- MANHÃ -->

<h3 class="mt-4 mb-3">MANHÃ</h3>

<% @morning_subjects.sort_by { |subject, _|
     subject.respond_to?(:code) ? subject.code : subject
   }.each do |subject, items| %>

<div class="subject-container">

  <h4 class="subject-header">
    <%= subject.respond_to?(:name) ? subject.name : subject %>
  </h4>
  
  <table class="attendance-table">
    <thead>
      <tr>
        <th style="width: 8%">Turma</th>
        <th style="width: 40%">Aluno</th>
        <th style="width: 52%">Assinatura</th>
      </tr>
    </thead>

    <tbody>

      <% items.each do |item| %>

        <tr>
          <td>
            <%= "#{item[:school_class].grade} #{item[:school_class].identifier}" %>
          </td>

          <td>
            <%= item[:student].name %>
          </td>

          <td></td>
        </tr>

      <% end %>

    </tbody>
  </table>
</div>
<% end %>

<hr class="my-5">

<!-- TARDE -->

<h3 class="mt-4 mb-3">TARDE</h3>

<% @afternoon_subjects.sort_by { |subject, _|
     subject.respond_to?(:code) ? subject.code : subject
   }.each do |subject, items| %>

  <div class="subject-container">

  <h4 class="subject-header">
  <%= subject.respond_to?(:name) ? subject.name : subject %>
</h4>

  <table class="attendance-table">
    <thead>
      <tr>
        <th style="width: 8%">Turma</th>
        <th style="width: 40%">Aluno</th>
        <th style="width: 52%">Assinatura</th>
      </tr>
    </thead>

    <tbody>

     <% items.each do |item| %>

        <tr>
          <td>
            <%= "#{item[:school_class].grade} #{item[:school_class].identifier}" %>
          </td>

          <td>
            <%= item[:student].name %>
          </td>

          <td></td>
        </tr>

      <% end %>

    </tbody>
  </table>
</div>

<% end %>