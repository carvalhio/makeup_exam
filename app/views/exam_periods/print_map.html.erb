<div class="print-wrapper">

  <% ["Manhã", "Tarde"].each do |shift| %>

    <% next unless @print_map[shift].present? %>

    <div class="print-shift">

      <div class="print-shift-title">
        Aplicação pela <%= shift.downcase %>
      </div>

      <table class="print-map-table">

        <thead>
          <tr>
            <th>Turma</th>
            <th>
              <%= @exam_period.exam_type == "Global" ? "Área" : "Comp. curricular" %>
            </th>
            <th>Qtd.</th>
          </tr>
        </thead>

        <tbody>

          <% @print_map[shift].each_with_index do |(grade, subjects), grade_index| %>

            <% if grade_index > 0 %>
              <tr class="grade-divider">
                <td colspan="3"></td>
              </tr>
            <% end %>

            <% subject_items = subjects.to_a %>

            <% subject_items.each_with_index do |(subject, quantity), subject_index| %>

              <tr>

                <% if subject_index == 0 %>
                  <td rowspan="<%= subject_items.length %>" class="grade">
                    <%= grade %>
                  </td>
                <% end %>

                <td>
                  <%= subject %>
                </td>

                <td class="quantity">
                  <%= quantity %>
                </td>

              </tr>

            <% end %>

          <% end %>

        </tbody>

      </table>

    </div>

  <% end %>

</div>


<div class="no-print">
  <%= link_to "Gerar PDF",
        print_map_exam_period_path(
          @exam_period,
          format: :pdf
        ),
        target: "_blank",
        class: "btn btn-primary mt-3" %>
</div>