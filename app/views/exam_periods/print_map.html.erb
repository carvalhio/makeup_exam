<h1 class="mb-3">Mapa de Impressão - 2ª Chamada</h1>

<p class="text-muted mb-3">
  <strong>Período:</strong> <%= @exam_period.name %>
</p>

<% ["Manhã", "Tarde"].each do |shift| %>

  <% next unless @print_map[shift] %>

  <div class="mb-4 print-group">

    <h5 class="mb-1 fw-bold">
      Turno da <%= shift.downcase %>
    </h5>

    <small class="text-muted d-block mb-2">
      <% if shift == "Manhã" %>
        Alunos matriculados no turno da tarde
      <% else %>
        Alunos matriculados no turno da manhã
      <% end %>
    </small>

    <table class="table table-sm table-bordered align-middle print-map-table">

      <thead>
        <tr>
          <th>Turma</th>
          <th>Disciplina</th>
          <th>Qtd.</th>
        </tr>
      </thead>

      <tbody>
        <% @print_map[shift].each do |grade, subjects| %>
          <% subjects.each do |subject, quantity| %>
            <tr>
              <td><%= grade %></td>
              <td><%= subject %></td>
              <td><%= quantity %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>

    </table>

  </div>

<% end %>