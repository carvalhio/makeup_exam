<div class="exam-period-container">
<h1>
  2ª Chamada -
  <%= @exam_period.stage %> -
  <%= @exam_period.exam_type %>
</h1>

<hr>

<div style="margin: 20px 0;">

  <%= link_to "Inserir novo aluno",
      new_exam_period_exam_request_path(@exam_period),
      class: "btn btn-primary btn-sm" %>
  
  <%= link_to "Lista de Frequência",
            attendance_list_exam_period_path(@exam_period),
            class: "btn btn-primary" %>

  <%= link_to "Mapa de Impressão",
    print_map_exam_period_path(@exam_period),
    class: "btn btn-success btn-sm" %>
    
</div>

<hr>

<% if @exam_requests.any? %>

  <% @requests_grouped.each do |school_class, requests| %>

    <div class="mb-4 exam-group">

      <h5 class="exam-group-title">
        <%= school_class %>
      </h5>

     <table class="table table-bordered table-sm exam-table">

        <thead>

          <tr>
            <th class="col-aluno col-md-4">Aluno</th>
            <th class="subjects">Comp. curricular</th>
            <th class="reason">Motivo</th>
          </tr>

        </thead>

        <tbody>

          <% requests.each do |request| %>

            <tr>

              <td>
                <%= link_to request.student.name,
                    edit_exam_period_exam_request_path(
                      @exam_period,
                      request
                    ),
                    class: "text-decoration-none fw-semibold" %>
              </td>

              <td>
                <%= request.display_subjects %>
              </td>
              
              <td>
                <%= request.reason %>
              </td>             
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% end %>

<% else %>

  <p>
    Nenhuma aluno cadastrado para este período!
  </p>

<% end %>
</div>