<h1>
  2ª Chamada -
  <%= @exam_period.stage %> -
  <%= @exam_period.exam_type %>
</h1>

<hr>

<div style="margin: 20px 0;">

  <%= link_to "Inserir novo aluno",
      new_exam_period_exam_request_path(@exam_period),
      class: "btn btn-primary btn-sm" %>
  
  <%= link_to "Gerar frequência",
      new_exam_period_exam_request_path(@exam_period),
      class: "btn btn-outline-primary btn-sm" %>

  <%= link_to "Mapa de Impressão",
    print_map_exam_period_path(@exam_period),
    class: "btn btn-success btn-sm" %>
    
</div>

<hr>

<% if @exam_requests.any? %>

  <% @requests_grouped.each do |school_class, requests| %>

    <div class="mb-4 exam-group">

      <h5 class="exam-group-title">
        <%= school_class %>
      </h5>

     <table class="table table-bordered table-hover table-sm align-middle requests-table">

        <thead>

          <tr>
            <th class="col-aluno">Aluno</th>
            <th class="subjects">Comp. curricular</th>
            <th class="reason">Motivo</th>
            <th class="actions"></th>
          </tr>

        </thead>

        <tbody>

          <% requests.each do |request| %>

            <tr>

              <td>
                <%= request.student.name %>
              </td>

              <td>

                <%= request.subjects
                           .map(&:name)
                           .join(", ") %>

              </td>

              <td>
                <%= request.reason %>
              </td>

              <td class="text-center col-actions">

              <%= button_to "Excluir",
                  exam_period_exam_request_path(
                    @exam_period,
                    request
                  ),
                  method: :delete,
                  data: {
                    turbo_confirm: "Excluir #{request.student.name}(#{school_class})?"
                  },
                  class: "btn btn-danger btn-sm" %>

            </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% end %>

<% else %>

  <p>
    Nenhuma aluno cadastrado para este período!
  </p>

<% end %>