<h1>
  2ª Chamada -
  <%= @exam_period.stage %> -
  <%= @exam_period.exam_type %>
</h1>

<hr>

<div style="margin: 20px 0;">

  <%= link_to "Nova Solicitação",
      new_exam_period_exam_request_path(@exam_period),
      class: "btn-new" %>

</div>

<hr>

<h2>Solicitações</h2>

<% if @exam_requests.any? %>

  <% @requests_grouped.each do |school_class, requests| %>

    <div style="margin-bottom: 30px;">

      <h3>
        <%= school_class %>
      </h3>

      <table border="1"
             cellpadding="10"
             cellspacing="0"
             width="100%">

        <thead>

          <tr>
            <th>Aluno</th>
            <th>Disciplinas</th>
            <th>Motivo</th>
            <th></th>
          </tr>

        </thead>

        <tbody>

          <% requests.each do |request| %>

            <tr>

              <td>
                <%= request.student.name %>
              </td>

              <td>

                <%= request.subjects
                           .map(&:name)
                           .join(", ") %>

              </td>

              <td>
                <%= request.reason %>
              </td>

              <td>

                <%= button_to "Excluir",
                    exam_period_exam_request_path(
                      @exam_period,
                      request
                    ),
                    method: :delete,
                    data: {
                      turbo_confirm: "Tem certeza?"
                    } %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    </div>

  <% end %>

<% else %>

  <p>
    Nenhuma solicitação cadastrada neste período.
  </p>

<% end %>