<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">

    <a class="navbar-brand" href="#">
      <%= image_tag "carvalhio_horizontal.png", alt: "CARVALHiO", class: "navbar-logo" %>   
    </a>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">

      <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <!-- INÍCIO -->
        <li class="nav-item">
          <%= link_to "Início",
              root_path,
              class: "nav-link #{'active' if current_page?(root_path)}" %>
        </li>

        <!-- DROPDOWN STIMULUS (SEM BOOTSTRAP JS) -->
        <li class="nav-item position-relative" data-controller="dropdown">

          <a class="nav-link" href="#"
             data-action="click->dropdown#toggle">
            2ª Chamada ▼
          </a>

          <!-- MENU CONTROLADO POR STIMULUS -->
          <div data-dropdown-target="menu"
               class="position-absolute bg-dark p-2"
               style="display: none; min-width: 220px; z-index: 999;">

            <% ["1ª Etapa", "2ª Etapa", "3ª Etapa", "4ª Etapa"].each do |stage| %>

              <% partial_period = ExamPeriod.find_by(stage: stage, exam_type: "Parcial") %>
              <% global_period   = ExamPeriod.find_by(stage: stage, exam_type: "Global") %>

              <div class="text-white fw-bold mt-2">
                <%= stage %>
              </div>

              <% if partial_period %>
                <%= link_to "Parcial",
                    exam_period_path(partial_period),
                    class: "d-block text-white text-decoration-none ms-2" %>
              <% end %>

              <% if global_period %>
                <%= link_to "Global",
                    exam_period_path(global_period),
                    class: "d-block text-white text-decoration-none ms-2" %>
              <% end %>

              <hr class="text-secondary my-2">

            <% end %>

          </div>
        </li>

        <!-- LINKS SIMPLES -->
        <li class="nav-item">
          <%= link_to "Turmas", school_classes_path, class: "nav-link" %>
        </li>
        
        <li class="nav-item">
          <%= link_to "AEE", aee_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "Mapa de impressão", print_map_path, class: "nav-link" %>
        </li>

      </ul>

      <!-- SEARCH DE ALUNOS -->
      <div class="d-flex align-items-center ms-lg-3 me-lg-4 mt-2 mt-lg-0 position-relative"
        data-controller="student-search"
        data-action="click@document->student-search#closeOnOutsideClick keydown@document->student-search#closeOnEscape">

        <form class="d-flex align-items-center m-0"
              role="search"
              onsubmit="return false;">

          <input class="form-control form-control-sm me-2"
                type="search"
                placeholder="Buscar aluno"
                aria-label="Buscar aluno"
                autocomplete="off"
                data-student-search-target="input"
                data-action="input->student-search#search" />

          <button class="btn btn-outline-success btn-sm"
                  type="button"
                  data-action="click->student-search#search">
            Pesquisa
          </button>

        </form>

        <div class="list-group position-absolute w-100 shadow-sm"
            style="top: 100%; right: 0; z-index: 1050; max-height: 300px; overflow-y: auto;"
            data-student-search-target="results"
            hidden>
        </div>

      </div>

    </div>
  </div>
</nav>