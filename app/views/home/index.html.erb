<div class="dashboard-container">

  <header class="dashboard-header">
    <h1>Sistema de 2ª Chamada</h1>
    <p>Gerenciamento de solicitações, alunos e relatórios</p>
  </header>

  <section class="dashboard-section">
    <h2>Cadastros</h2>

    <div class="cards-grid">
      
      <%= link_to exam_requests_path, class: "dashboard-card" do %>
        <div class="card-icon">📝</div>
        <h3>Solicitações</h3>
        <p>Controle das 2ª chamadas</p>
      <% end %>

      <%= link_to school_classes_path, class: "dashboard-card" do %>
        <div class="card-icon">🏫</div>
        <h3>Turmas</h3>
        <p>Gerencie as turmas cadastradas</p>
      <% end %>

      <%= link_to students_path, class: "dashboard-card" do %>
        <div class="card-icon">👨‍🎓</div>
        <h3>Alunos</h3>
        <p>Cadastro e consulta de alunos</p>
      <% end %>
      
    </div>
  </section>

  <section class="dashboard-section">
    <h2>Relatórios</h2>

    <div class="cards-grid">

      <%= link_to reports_path, class: "dashboard-card" do %>
        <div class="card-icon">📄</div>
        <h3>Relatório de Impressão</h3>
        <p>Visualize e imprima relatórios</p>
      <% end %>

    </div>
  </section>

</div>