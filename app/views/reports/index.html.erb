<div class="reports-page">

  <div class="report-header">
    <h1>Relatório de Impressão</h1>
    <p>Quantidade de provas por turma e disciplina</p>
  </div>

  <% @grouped_data.each do |school_class, subjects| %>

    <section class="report-section">

      <h2><%= school_class %></h2>

      <table class="report-table">

        <thead>
          <tr>
            <th>Comp. Curricular</th>
            <th>Quantidade</th>
          </tr>
        </thead>

        <tbody>
          <% subjects.each do |subject, quantity| %>
            <tr>
              <td><%= subject %></td>
              <td class="quantity"><%= quantity %></td>
            </tr>
          <% end %>
        </tbody>

      </table>

    </section>


  <% end %>
<%= link_to "🏠 Início", root_path, class: "btn btn-home" %>
</div>
<button onclick="window.print()">
  Imprimir
</button>