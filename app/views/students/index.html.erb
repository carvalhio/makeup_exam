<div class="students-page">

  <% if notice.present? %>
    <div class="notice">
      <%= notice %>
    </div>
  <% end %>

  <% content_for :title, "Students" %>

  <div class="page-header">
    <h1>Alunos</h1>
  </div>

  <table class="students-table">

    <thead>

      <tr>
        <th>ID</th>
        <th>Nome</th>
        <th>Ações</th>
      </tr>

    </thead>

    <tbody>

      <% @students.each do |student| %>

        <tr>

          <td>
            <%= student.id %>
          </td>

          <td>
            <%= student.name %>
          </td>

          <td class="actions-column">

            <%= link_to "Ver",
                student,
                class: "table-btn btn-view" %>

            <%= link_to "Editar",
                edit_student_path(student),
                class: "table-btn btn-edit" %>

          </td>

        </tr>

      <% end %>

    </tbody>

  </table>

  <div class="bottom-actions">

    <%= link_to "➕ Novo aluno",
        new_student_path,
        class: "btn btn-new" %>

    <%= link_to "🏠 Início",
        root_path,
        class: "btn btn-home" %>

  </div>

</div>
