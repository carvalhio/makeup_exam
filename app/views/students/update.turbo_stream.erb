<%= turbo_stream.replace "student_row_#{@student.id}" do %>
  <tr id="student_row_<%= @student.id %>" data-bs-toggle="modal" data-bs-target="#editStudentModal<%= @student.id %>" style="cursor: pointer;">
    <td><%= @student.name %> <% if @student.aee %><span class="badge bg-warning text-dark ms-2" style="font-size: 10px;">AEE</span><% end %></td>
  </tr>
<% end %>

<%= turbo_stream.append "toasts" do %>
  <div class="toast align-items-center text-bg-success border-0 show mb-2" role="alert">
    <div class="d-flex">
      <div class="toast-body">Aluno atualizado com sucesso!</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
<% end %>