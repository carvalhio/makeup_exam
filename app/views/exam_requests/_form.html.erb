
<% selected_class_id = exam_request.student&.school_class_id %>

<% students =
     selected_class_id.present? ?
       Student.where(school_class_id: selected_class_id)
              .order(:name)
              .pluck(:name, :id) :
       [] %>

<div class="exam-request-form">

<%= form_with(model: [@exam_period, exam_request]) do |form| %>

  <% if exam_request.errors.any? %>

    <div class="alert alert-danger">

      <h6 class="fw-bold mb-2">
        Foram encontrados
        <%= pluralize(exam_request.errors.count, "erro") %>:
      </h6>

      <ul class="mb-0">

        <% exam_request.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>

      </ul>

    </div>

  <% end %>

  <div
    data-controller="exam-request"
    data-exam-request-period-id-value="<%= @exam_period.id %>">

    <div class="row mb-3">

  <div class="col-md-3">

   <%= form.date_field :application_date, class: "form-control", data: { exam_request_target: "applicationDate" } %>

  </div>

</div>
    <!-- ====================================================== -->
    <!-- DADOS DO ALUNO -->
    <!-- ====================================================== -->

    <div class="card shadow-sm mb-3">

      <div class="card-header fw-bold">
        Dados do Aluno
      </div>

      <div class="card-body">

        <div class="row">

          <!-- TURMA -->
          <div class="col-md-4">

            <%= label_tag :school_class_id,
                "Turma",
                class: "form-label fw-bold" %>

            <%= select_tag(
              :school_class_id,
              options_from_collection_for_select(
                SchoolClass.order(:grade, :identifier),
                :id,
                :full_name,
                selected_class_id
              ),
              prompt: "Selecione uma turma",
              class: "form-select",
              data: {
                exam_request_target: "schoolClass",
                action: "change->exam-request#loadStudents"
              }
            ) %>

          </div>

          <!-- ALUNO -->
          <div class="col-md-6">

            <%= form.label :student_id,
                "Aluno",
                class: "form-label fw-bold" %>

            <%= form.select(
              :student_id,
              students,
              { prompt: "Selecione um aluno" },
              {
                class: "form-select",
                data: {
                  exam_request_target: "student",
                  action: "change->exam-request#checkExisting"
                }
              }
            ) %>

          </div>

        </div>

        <div class="same-shift-box mt-3">

          <div class="form-check">

            <%= form.check_box :same_shift,
                class: "form-check-input" %>

            <%= form.label :same_shift,
                "Aluno realizará a prova no turno matriculado",
                class: "form-check-label" %>

          </div>

        </div>

      </div>

    </div>

    <!-- ====================================================== -->
    <!-- DISCIPLINAS -->
    <!-- ====================================================== -->

    <!-- DISCIPLINAS / ÁREAS -->
<div class="subjects-box">

  <% if @exam_period.exam_type == "Parcial" %>

    <label class="form-label fw-bold mb-2">
      Disciplinas
    </label>

    <div class="subjects-columns">

      <% Subject.order(:name).each do |subject| %>

        <div class="form-check">

          <%= check_box_tag(
            "exam_request[subject_ids][]",
            subject.id,
            exam_request.subject_ids.include?(subject.id),
            class: "form-check-input"
          ) %>

          <%= label_tag(
            "exam_request_subject_ids_#{subject.id}",
            subject.name,
            class: "form-check-label"
          ) %>

        </div>

      <% end %>

    </div>

  <% else %>

    <label class="form-label fw-bold mb-2">
      Áreas da Global
    </label>

    <div class="subjects-columns">

      <div class="form-check">
        <%= check_box_tag(
          "global_areas[]",
          "linguagens",
          @selected_global_areas&.include?("linguagens")
        ) %>
        <%= label_tag nil, "Linguagens, Códigos e suas Tecnologias" %>
      </div>

      <div class="form-check">
        <%= check_box_tag(
        "global_areas[]",
        "natureza",
        @selected_global_areas&.include?("natureza")
      ) %>
        <%= label_tag nil, "Ciências da Natureza e suas Tecnologias" %>
      </div>

      <div class="form-check">
      <%= check_box_tag(
      "global_areas[]",
      "matematica",
      @selected_global_areas&.include?("matematica")
      ) %>
        <%= label_tag nil, "Matemática e suas Tecnologias" %>
      </div>

      <div class="form-check">
        <%= check_box_tag(
          "global_areas[]",
          "humanas",
          @selected_global_areas&.include?("humanas")
        ) %>
        <%= label_tag nil, "Ciências Humanas e suas Tecnologias" %>
      </div>

      <div class="form-check">
        <%= check_box_tag(
          "global_areas[]",
          "redacao",
          @selected_global_areas&.include?("redacao")
        ) %>
        <%= label_tag nil, "Redação" %>
      </div>

      <div class="form-check">
        <%= check_box_tag(
          "global_areas[]",
          "ed_fisica",
          @selected_global_areas&.include?("ed_fisica")
        ) %>
        <%= label_tag nil, "Educação Física" %>
      </div>

    </div>

  <% end %>

    </div>

    <!-- ====================================================== -->
    <!-- JUSTIFICATIVA -->
    <!-- ====================================================== -->

    <div class="card shadow-sm mb-3">

      <div class="card-header fw-bold">
        Justificativa
      </div>

      <div class="card-body">

        <div class="row">

          <!-- MOTIVO -->
          <div class="col-md-4">

            <%= form.label :reason,
                "Motivo",
                class: "form-label fw-bold" %>

            <%= form.select(
              :reason,
              [
                "Atestado Médico",
                "Falta Justificada",
                "Viagem",
                "Outro",
                "Progressão de Notas"
              ],
              { prompt: "Selecione um motivo" },
              class: "form-select"
            ) %>

          </div>

          <!-- DESCRIÇÃO -->
          <div class="col-md-8">

            <%= form.label :reason_description,
                "Descrição complementar",
                class: "form-label fw-bold" %>

            <%= form.text_area :reason_description,
                class: "form-control",
                rows: 3,
                placeholder: "Informe detalhes adicionais, se necessário..." %>

          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- ====================================================== -->
  <!-- BOTÕES -->
  <!-- ====================================================== -->

  <div class="form-actions">

    <%= link_to "Cancelar",
        exam_period_path(@exam_period),
        class: "btn btn-outline-secondary" %>

    <%= form.submit "Salvar Solicitação",
        class: "btn btn-success" %>

  </div>

<% end %>

</div>