<%= form_with(model: [@exam_period, exam_request]) do |form| %>
  <% if exam_request.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(exam_request.errors.count, "error") %> prohibited this exam_request from being saved:</h2>

      <ul>
        <% exam_request.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- ALUNO -->
  <div data-controller="exam-request">

  <!-- TURMA -->
  <div>

    <%= label_tag :school_class_id, "Turma" %>

    <%= select_tag(
      :school_class_id,
      options_from_collection_for_select(
        SchoolClass.order(:grade, :identifier),
        :id,
        :full_name
      ),
      prompt: "Selecione uma turma",
      data: {
        exam_request_target: "schoolClass",
        action: "change->exam-request#loadStudents"
      }
    ) %>

  </div>

  <br>

  <!-- ALUNO -->
  <div>

    <%= form.label :student_id, "Aluno" %>

    <%= form.select(
      :student_id,
      [],
      { prompt: "Selecione um aluno" },
      data: {
        exam_request_target: "student"
      }
    ) %>

  </div>

</div>

  <br>

  <!-- DISCIPLINAS -->
  <div>
    <strong>Disciplinas</strong>

    <% Subject.order(:name).each do |subject| %>
      <div>
        <%= check_box_tag(
          "exam_request[subject_ids][]",
          subject.id,
          @exam_request.subject_ids.include?(subject.id)
        ) %>

        <%= label_tag "exam_request_subject_ids_#{subject.id}", subject.name %>
      </div>
    <% end %>
  </div>

  <br>

  <!-- MOTIVO -->
  <div>
    <%= form.label :reason, "Motivo", style: "display: block" %>

    <%= form.select :reason, [
      "Atestado Médico",
      "Falta Justificada",
      "Viagem",
      "Outro"
    ] %>
  </div>

  <br>

  <!-- DESCRIÇÃO -->
  <div>
    <%= form.label :reason_description, "Descrição complementar", style: "display: block" %>

    <%= form.text_area :reason_description %>
  </div>

  <br>

  <!-- SUBMIT -->
  <div>
    <%= form.submit %>
  </div>
<% end %>