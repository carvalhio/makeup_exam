<div class="exam-request-show">

  <% if notice.present? %>
    <div class="notice">
      <%= notice %>
    </div>
  <% end %>

  <div class="page-header">
    <h1>Solicitação de 2ª Chamada</h1>
  </div>

  <table class="details-table">
    <tbody>

      <tr>
        <th>Aluno</th>
        <td><%= @exam_request.student.name %></td>
      </tr>

      <% if @exam_request.subjects.any? %>
    <tr>
    <th>Disciplina</th>
    <td><%= @exam_request.subjects.map(&:name).join(", ") %></td>
  </tr>
<% end %>

      <tr>
       <th>Período</th>
           <td><%= @exam_request.exam_period&.stage || "Não definido" %></td>
       </tr>

      <tr>
        <th>Solicitado em</th>
        <td><%= l(@exam_request.created_at, format: :short) %></td>
      </tr>

    </tbody>
  </table>
 

  <div class="actions">

    <%= link_to "🏠 Início",
        root_path,
        class: "btn btn-home" %>

    <%= link_to "✏️ Editar",
    edit_exam_period_exam_request_path(@exam_period, @exam_request),
    class: "btn btn-edit" %>

    <%= link_to "⬅ Voltar",
    exam_period_exam_requests_path(@exam_period),
    class: "btn btn-back" %>

    <<%= button_to "🗑 Excluir",
    exam_period_exam_request_path(@exam_period, @exam_request),
    method: :delete,
    class: "btn btn-delete" %>

  </div>

</div>