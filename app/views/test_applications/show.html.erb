<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Lista de frequência</h1>
  <%= link_to "Baixar PDF", pdf_test_application_path(@test_application), class: "btn btn-primary btn-sm" %>
</div>

<style>
  .frequency-html-wrapper {
    max-width: 750px;
    margin: 0 auto;
    background: #fff;
    padding: 15px;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
  }
  .frequency-html-wrapper .frequency-page {
    min-height: auto !important;
    padding-bottom: 0 !important;
  }
  .frequency-html-wrapper .frequency-table {
    width: 100%;
    font-size: 12px !important;
    border-collapse: collapse;
    table-layout: fixed; /* FORÇA AS LARGURAS */
  }
  .frequency-html-wrapper .frequency-table th {
    font-size: 11px !important;
    padding: 4px 6px !important;
  }
  .frequency-html-wrapper .frequency-table td {
    font-size: 11px !important;
    padding: 3px 6px !important;
    height: 22px;
  }
  .frequency-html-wrapper .frequency-table .number-column {
    width: 38px !important;
    min-width: 38px !important;
    max-width: 38px !important;
    text-align: center !important;
  }
  .frequency-html-wrapper .frequency-table .signature-column {
    width: 35% !important;
  }
</style>

<div class="frequency-html-wrapper">
  <div class="frequency-pdf">
    <% @test_application.school_classes.each_with_index do |school_class, index| %>
      <section class="frequency-page">
        <div class="frequency-header" style="border-bottom: 1px solid #2e2d2d; padding-bottom: 8px; margin-bottom: 15px; position: relative; text-align: center;">
          <div style="position: absolute; top: 0; right: 0;">
            <img src="<%= asset_path('logo.png') %>" style="width: 60px;" />
          </div>
          <h1 style="text-align: center; text-transform: uppercase;">Lista de frequência - <%= "#{school_class.grade} #{school_class.identifier}" %></h1>
          <div style="text-align: left; line-height: 1.6; margin-top: 10px;">
            <div><strong>Data:</strong> <%= @test_application.application_date.strftime("%d/%m/%Y") %></div>
            <div><strong>Componente:</strong> <%= @test_application.subject_name %></div>
            <div><strong>Fiscal:</strong> <%= @test_application.invigilator.presence || "________________________" %></div>
          </div>
        </div>

                <table class="frequency-table" style="table-layout: fixed !important; width: 100% !important;">
          <colgroup>
            <col style="width: 38px !important;">
            <col style="width: auto;">
            <col style="width: 35% !important;">
          </colgroup>
          <thead>
            <tr>
              <th style="width: 38px !important; min-width: 38px !important; max-width: 38px !important; text-align: center !important; padding: 3px 2px !important;">Nº</th>
              <th>Aluno</th>
              <th class="signature-column">Assinatura</th>
            </tr>
          </thead>
          <tbody>
            <% school_class.students.order(:name).each_with_index do |student, student_index| %>
              <tr>
                <td style="width: 38px !important; min-width: 38px !important; max-width: 38px !important; text-align: center !important; padding: 3px 2px !important; overflow: hidden;">
                  <%= student_index + 1 %>
                </td>
                <td><%= student.name %></td>
                <td class="signature-column"></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div style="margin-top: 15px;">
          <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
            <tr><th style="border: 1px dashed #999; background: #fff; text-align: center; font-size: 9px; color: #777; padding: 3px;">ESPAÇO DESTINADO AOS FISCAIS</th></tr>
            <tr><td style="border: 1px dashed #bbb; border-bottom: 1px solid #000; height: 6px;"></td></tr>
            <tr><th style="text-align: left; background: #fff; border: 1px solid #000; padding: 4px; font-size: 11px;">OBSERVAÇÕES</th></tr>
            <tr><td style="border: 1px solid #000; height: 18px;"></td></tr>
            <tr><td style="border: 1px solid #000; height: 18px;"></td></tr>
          </table>
        </div>
      </section>
      <% unless index == @test_application.school_classes.length - 1 %>
        <hr style="margin: 40px 0; border: 1px dashed #ccc;">
      <% end %>
    <% end %>
  </div>
</div>