
<div class="frequency-pdf">

  <% @test_application.school_classes.each_with_index do |school_class, index| %>

    <div class="frequency-page">

      <%
        exam_type = @test_application.exam_type == "Global" ? "globais" : "parciais"

        grade = school_class.grade
        ensino_medio = ["1ª", "2ª", "3ª"].include?(grade)
      %>

      <!-- CABEÇALHO -->

      <div class="frequency-header">

        <img
          src="<%= wicked_pdf_asset_base64('logo.png') %>"
          class="frequency-logo"
        />

        <h1 class="turma-titulo">
          Lista de frequência para testes <%= exam_type %> - <%= @test_application.stage %> -
          <strong>
            <%= grade %><%= content_tag(:span, "s", class: "serie-s") if ensino_medio %>
            <%= school_class.identifier %>
          </strong>
        </h1>

        <div class="frequency-info">

          <div>
            <strong>Data:</strong>
            <%= @test_application.application_date.strftime("%d/%m/%Y") %>
          </div>

          <div class="info-item">
            <strong>Componente curricular:</strong>
            <%= @test_application.subject_name.presence || "________________________" %>
          </div>

          <div class="fiscal-item">
            <strong>Fiscal responsável:</strong>

            <% if @test_application.invigilator.present? %>

              <span class="fiscal-name">
                <%= @test_application.invigilator %>
              </span>

              <span class="fiscal-blank"></span>

            <% else %>

              <span class="fiscal-blank fiscal-blank--empty"></span>

            <% end %>
          </div>

        </div>

      </div>

      <!-- TABELA DE ALUNOS -->

      <table class="frequency-table">

        <colgroup>
          <col class="number-column">
          <col class="student-column">
          <col class="signature-column">
        </colgroup>

        <thead>
          <tr>
            <th class="number-column">Nº</th>
            <th class="student-column">Aluno(a)</th>
            <th class="signature-column">Assinatura</th>
          </tr>
        </thead>

        <tbody>

          <%
            students = if @test_application.include_aee
              school_class.students
            else
              school_class.students.where(aee: false)
            end
          %>

          <% students.order(:name).each_with_index do |student, student_index| %>

            <tr>
              <td class="number-column">
                <%= student_index + 1 %>
              </td>

              <td class="student-column">
                <%= student.name %>
              </td>

              <td class="signature-column"></td>
            </tr>

          <% end %>

        </tbody>

      </table>

      <!-- OBSERVAÇÕES / CONSIDERAÇÕES -->

      <div class="frequency-spacer"></div>

      <div class="observations-wrapper">

        <table class="observations-table">

          <thead>
            <tr>
              <th>OBSERVAÇÕES / CONSIDERAÇÕES</th>
            </tr>
          </thead>

          <tbody>
            <% 3.times do %>
              <tr>
                <td></td>
              </tr>
            <% end %>
          </tbody>

        </table>

      </div>

    </div>

    <% unless index == @test_application.school_classes.length - 1 %>
      <div class="frequency-page-break"></div>
    <% end %>

  <% end %>

</div>
