<div class="frequency-pdf">
  <% @test_application.school_classes.each_with_index do |school_class, index| %>
    <div class="frequency-page">

      <!-- CABEÇALHO COM TÍTULO CENTRALIZADO E LOGO -->
      <div class="frequency-header" style="border-bottom: 1px solid #2e2d2d; padding-bottom: 8px; margin-bottom: 15px; width: 100%; position: relative; text-align: center;">
        <div style="position: absolute; top: 0; right: 0;">
          <img src="<%= wicked_pdf_asset_base64('logo.png') %>" style="width: 75px; height: auto;" />
        </div>
        <h1 style="font-size: 12px; font-weight: bold; text-transform: uppercase; margin: 0 0 10px 0; text-align: center;">
          Lista de frequência para testes - <%= "#{school_class.grade} #{school_class.identifier}" %>
        </h1>
        <div style="font-size: 13px; line-height: 1.8; text-align: left; margin-top: 10px;">
          <div class="frequency-info">
            <strong>Data:</strong> <%= @test_application.application_date.strftime("%d/%m/%Y") %>
            <span style="margin-left: 30px;">
              <strong>Componente curricular:</strong> <%= @test_application.subject_name.presence || "________________________" %>
            </span>
          </div>
          <div class="frequency-info fiscal-line" style="margin-top: 8px;">
            <strong>Fiscal responsável:</strong>
            <% if @test_application.invigilator.present? %>
              <span><%= @test_application.invigilator %></span>
              <span style="display: inline-block; border-bottom: 1px solid #000; width: 250px; margin-left: 10px; margin-bottom: -2px;"></span>
            <% else %>
              <span style="display: inline-block; border-bottom: 1px solid #000; width: 320px; margin-bottom: -2px; height: 16px;"></span>
            <% end %>
          </div>
        </div>
      </div>

      <table class="frequency-table">
        <thead>
          <tr>
            <th class="number-column">Nº</th>
            <th>Aluno</th>
            <th class="signature-column">Assinatura</th>
          </tr>
        </thead>
        <tbody>
          <% school_class.students.order(:name).each_with_index do |student, student_index| %>
            <tr>
              <td class="number-column"><%= student_index + 1 %></td>
              <td><%= student.name %></td>
              <td class="signature-column"></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <!-- RODAPÉ NORMAL - LOGO ABAIXO DA TABELA -->
      <div style="margin-top: 20px; background: #fff;">
        <table style="width: 100%; border-collapse: collapse;">
          <tr>
            <th style="border: 1px dashed #0a0a0a !important; padding: 2px 6px; text-align: center; font-size: 9px; color: #777 !important; background: #fff !important; font-style: italic; text-transform: uppercase;">
              ESPAÇO DESTINADO AOS FISCAIS
            </th>
          </tr>
          <tr>
            <td style="border-left: 1px dashed #bbb !important; border-right: 1px dashed #bbb !important; border-top: 1px dashed #bbb !important; border-bottom: 1px solid #000 !important; height: 6px; background: #fff !important;"></td>
          </tr>
          <tr>
            <th style="text-align: left; font-size: 12px; color: #000; background: #fff !important; border: 1px solid #000; padding: 5px;">
              OBSERVAÇÕES / CONSIDERAÇÕES
            </th>
          </tr>
          <tr><td style="border: 1px solid #000; height: 22px; background: #fff !important;"></td></tr>
          <tr><td style="border: 1px solid #000; height: 22px; background: #fff !important;"></td></tr>
          <tr><td style="border: 1px solid #000; height: 22px; background: #fff !important;"></td></tr>
        </table>
      </div>

    </div>
    <% unless index == @test_application.school_classes.length - 1 %>
      <div style="page-break-after: always;"></div>
    <% end %>
  <% end %>
</div>