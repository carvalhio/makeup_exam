<div class="frequency-pdf">
  <% @test_application.school_classes.each_with_index do |school_class, index| %>
    <div class="frequency-page">
       
       <!-- CABEÇALHO SEM LINHA -->
      <div class="frequency-header" style="padding-bottom: 8px; margin-bottom: 10px; width: 100%; position: relative; text-align: center; border: none;">
        
        <div style="position: absolute; top: 0; right: 0;">
          <img src="<%= wicked_pdf_asset_base64('logo.png') %>" style="width: 90px; height: auto;" />
        </div>

        <h1 style="font-size: 12px; font-weight: bold; text-transform: uppercase; margin: 0 0 10px 0; text-align: center;">
          Lista de frequência para testes - <%= "#{school_class.grade} #{school_class.identifier}" %>
        </h1>

        <div style="font-size: 13px; line-height: 1.6; text-align: left; margin-top: 8px;">
          
          <div>
            <strong>Data:</strong> <%= @test_application.application_date.strftime("%d/%m/%Y") %>
          </div>

          <div style="margin-top: 4px;">
            <strong>Componente curricular:</strong> <%= @test_application.subject_name.presence || "________________________" %>
          </div>

          <!-- FISCAL - LINHA ATÉ O FINAL DA BORDA -->
          <div style="margin-top: 4px; white-space: nowrap;">
            <strong>Fiscal responsável:</strong>
            <% if @test_application.invigilator.present? %>
              <span style="margin-left: 4px;"><%= @test_application.invigilator %></span>
              <span style="display: inline-block; border-bottom: 1px solid #000; width: 72%; margin-left: 8px; margin-bottom: -2px;"></span>
            <% else %>
              <span style="display: inline-block; border-bottom: 1px solid #000; width: 75%; margin-left: 8px; margin-bottom: -2px;"></span>
            <% end %>
          </div>
          
        </div>
      </div>

      <table class="frequency-table" style="table-layout: fixed; width: 100%; border-collapse: collapse;">
        <colgroup>
          <col style="width: 26px;">
          <col>
          <col style="width: 40%;">
        </colgroup>
        <thead>
          <tr style="height: 30px;">
            <th style="width: 26px; text-align: center; padding: 2px 1px !important; line-height: 1.15 !important; font-size: 13px;">Nº</th>
            <th style="text-align: center; padding: 2px 5px !important; line-height: 1.15 !important; font-size: 13px;">Aluno(a)</th>
            <th style="width: 40%; text-align: center; padding: 2px 1px !important; line-height: 1.15 !important; font-size: 13px;">Assinatura</th>
          </tr>
        </thead>
        <tbody>
<%
students = if @test_application.include_aee
  school_class.students
else
  school_class.students.where(aee: false)
end
%>

<% students.order(:name).each_with_index do |student, student_index| %>
  <tr>
    <td style="text-align: center; padding: 2px 1px; font-size: 12px;">
      <%= student_index + 1 %>
    </td>

    <td style="padding: 2px 5px; font-size: 12px;">
      <%= student.name %>
    </td>

    <td style="padding: 2px 1px; font-size: 12px;">
    </td>
  </tr>
<% end %>
  </tbody>
      </table>

      <div style="margin-top: 4px; page-break-inside: avoid;">
        <table style="width: 100%; border-collapse: collapse;">
          <tr>
            <th style="border: 1px dashed #0a0a0a !important; padding: 1px 6px; text-align: center; font-size: 7px; color: #777 !important; background: #fff !important; font-style: italic; text-transform: uppercase;">
              ESPAÇO DESTINADO AOS FISCAIS
            </th>
          </tr>
          <tr>
            <td style="border-left: 1px dashed #bbb !important; border-right: 1px dashed #bbb !important; border-top: 1px dashed #bbb !important; border-bottom: 1px solid #000 !important; height: 3px; background: #fff !important;"></td>
          </tr>
          <tr>
            <th style="text-align: left; font-size: 9px; background: #fff !important; border: 1px solid #000; padding: 2px 4px;">OBSERVAÇÕES / CONSIDERAÇÕES</th>
          </tr>
          <tr><td style="border: 1px solid #000; height: 14px; background: #fff !important;"></td></tr>
          <tr><td style="border: 1px solid #000; height: 14px; background: #fff !important;"></td></tr>
        </table>
      </div>

    </div>
    
    <% unless index == @test_application.school_classes.length - 1 %>
      <div style="page-break-after: always;"></div>
    <% end %>

  <% end %>
</div>