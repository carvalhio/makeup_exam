<%= form_with(model: school_class) do |form| %>
  <% if school_class.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(school_class.errors.count, "error") %> prohibited this school class from being saved:</h2>

      <ul>
        <% school_class.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :grade, "Série/Ano", style: "display: block" %>

    <%= form.select :grade, [
      "1º Ano",
      "2º Ano",
      "3º Ano",
      "4º Ano",
      "5º Ano",
      "6º Ano",
      "7º Ano",
      "8º Ano",
      "9º Ano",
      "1ª Série",
      "2ª Série",
      "3ª Série"
    ] %>
  </div>

  <br>

  <div>
    <%= form.label :identifier, "Turma", style: "display: block" %>

    <%= form.select :identifier, ["A", "B", "C", "D"] %>
  </div>

  <br>

  <div>
    <%= form.label :shift, "Turno", style: "display: block" %>

    <%= form.select :shift, ["Manhã", "Tarde"] %>
  </div>

  <br>

  <div>
    <%= form.submit %>
  </div>
<% end %>