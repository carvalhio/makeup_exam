<p style="color: green"><%= notice %></p>

<% content_for :title, "Turmas" %>

<style>
  .school-classes-wrapper {
    max-width: 650px;
    margin: 0 auto;
  }
  .school-classes-wrapper .table {
    font-size: 13px;
  }
  .school-classes-wrapper .table th,
  .school-classes-wrapper .table td {
    padding: 5px 8px !important;
    vertical-align: middle;
  }
  .col-turma { width: 40%; }
  .col-turno { width: 30%; }
  .col-qtd { width: 30%; text-align: center; }
</style>

<div class="school-classes-wrapper mt-3">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0" style="font-size: 22px;">Turmas</h1>
    <div class="d-flex gap-2">
      <%= link_to "Nova Turma", new_school_class_path, class: "btn btn-primary btn-sm" %>
      <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#frequencyModal">
        Lista de frequência
      </button>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <table class="table table-hover table-sm align-middle mb-0 small">
        <thead class="table-dark">
          <tr>
            <th class="col-turma">Turma</th>
            <th class="col-turno">Turno</th>
            <th class="col-qtd">quantidade</th>
          </tr>
        </thead>
        <tbody>
          <%
            grouped_classes = {
              "Anos Iniciais" => ["1º ano", "2º ano", "3º ano", "4º ano", "5º ano"],
              "Anos Finais"   => ["6º ano", "7º ano", "8º ano", "9º ano"],
              "Ensino Médio"  => ["1ª série", "2ª série", "3ª série"]
            }
          %>

          <% grouped_classes.each do |group_name, grades| %>
            <tr class="table-secondary">
              <td colspan="3" class="fw-bold text-uppercase small py-1">
                <%= group_name %>
              </td>
            </tr>

            <%
              classes = @school_classes.select { |c| grades.include?(c.grade) }
                         .sort_by { |c| [grades.index(c.grade), c.identifier.to_s] }
            %>

            <% classes.each do |school_class| %>
              <tr onclick="window.location='<%= school_class_path(school_class) %>'" style="cursor: pointer;">
                <td><%= "#{school_class.grade} #{school_class.identifier}" %></td>
                <td><%= school_class.shift %></td>
                <td class="text-center"><span class="badge bg-light text-dark border"><%= school_class.students.count %></span></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- =========================================
     MODAL - LISTA DE FREQUÊNCIA
========================================== -->
<div class="modal fade" id="frequencyModal" tabindex="-1" aria-labelledby="frequencyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <%= form_with model: TestApplication.new, url: test_applications_path, method: :post, local: true do |form| %>
        <div class="modal-header">
          <h5 class="modal-title" id="frequencyModalLabel">Lista de frequência</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>

        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <%= form.label :exam_type, "Tipo de prova", class: "form-label fw-bold" %>
              <%= form.select :exam_type, ["Parcial", "Global"], { prompt: "Selecione..." }, class: "form-select", required: true %>
            </div>

            <div class="col-md-6">
              <%= form.label :application_date, "Data da aplicação", class: "form-label fw-bold" %>
              <%= form.date_field :application_date, class: "form-control", required: true %>
            </div>

            <div class="col-md-12">
              <%= form.label :subject_name, "Componente curricular", class: "form-label fw-bold" %>
              <%= form.text_field :subject_name, class: "form-control", placeholder: "Digite o componente curricular", required: true %>
            </div>

            <div class="col-md-12">
              <%= form.label :invigilator, "Fiscal responsável", class: "form-label fw-bold" %>
              <%= form.text_field :invigilator, class: "form-control", placeholder: "Digite o nome do fiscal" %>
            </div>

            <div class="col-md-12">
              <label class="form-label fw-bold">Turmas</label>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="class_selection" id="allClasses" value="all" checked>
                <label class="form-check-label" for="allClasses">Todas as turmas</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="class_selection" id="selectedClasses" value="selected">
                <label class="form-check-label" for="selectedClasses">Selecionar turmas</label>
              </div>

              <div id="classesSelection" class="mt-3 p-3 border rounded d-none">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <strong>Selecionar turmas</strong>
                  <div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="selectAllClasses">Selecionar todas</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="clearAllClasses">Limpar seleção</button>
                  </div>
                </div>

                <div class="border rounded p-2" style="max-height: 250px; overflow-y: auto;">
                  <%
                    grouped_classes_modal = {
                      "Anos Iniciais" => ["1º ano", "2º ano", "3º ano", "4º ano", "5º ano"],
                      "Anos Finais" => ["6º ano", "7º ano", "8º ano", "9º ano"],
                      "Ensino Médio" => ["1ª série", "2ª série", "3ª série"]
                    }
                  %>

                  <% grouped_classes_modal.each do |group_name, grades| %>
                    <div class="mb-3">
                      <div class="fw-bold text-uppercase small mb-1"><%= group_name %></div>
                      <%
                        classes = @school_classes.select { |c| grades.include?(c.grade) }
                                   .sort_by { |c| [grades.index(c.grade), c.identifier.to_s] }
                      %>
                      <% classes.each do |school_class| %>
                        <div class="form-check">
                          <input class="form-check-input class-checkbox" type="checkbox" name="school_class_ids[]" value="<%= school_class.id %>" id="class_<%= school_class.id %>">
                          <label class="form-check-label" for="class_<%= school_class.id %>">
                            <%= "#{school_class.grade} #{school_class.identifier} - #{school_class.shift}" %>
                          </label>
                        </div>
                      <% end %>
                    </div>
                   
                  <% end %>      
                </div>
              </div>
            </div>
          </div>
        
        <div class="mb-3">
              <div class="form-check">

                <%= form.check_box :include_aee,
                    class: "form-check-input" %>

                <%= form.label :include_aee,
                    "Incluir alunos AEE",
                    class: "form-check-label fw-bold" %>

              </div>

              <small class="text-muted">
                alunos que fazem testes adaptados
              </small>


        </div>
        
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
          <%= form.submit "Gerar lista de frequência", class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>