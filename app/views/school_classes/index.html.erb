<p style="color: green"><%= notice %></p>

<% content_for :title, "Turmas" %>

<div class="container mt-3">

  <div class="d-flex justify-content-between align-items-center mb-2">

    <h1 class="mb-0">Turmas</h1>

    <div class="d-flex gap-2">

      <%= link_to "Nova Turma",
          new_school_class_path,
          class: "btn btn-primary btn-sm" %>

      <button
        type="button"
        class="btn btn-primary btn-sm"
        data-bs-toggle="modal"
        data-bs-target="#frequencyModal">
        Lista de frequência
      </button>

    </div>
  </div>


  <table class="table table-striped table-hover table-sm school-classes-table">

    <thead class="table-dark">
      <tr>
        <th>Turma</th>
        <th>Turno</th>
        <th>Quantidade</th>
        <th>...</th>
      </tr>
    </thead>

    <tbody>

      <%
        grouped_classes = {
          "Anos Iniciais" => ["1º ano", "2º ano", "3º ano", "4º ano", "5º ano"],
          "Anos Finais"   => ["6º ano", "7º ano", "8º ano", "9º ano"],
          "Ensino Médio"  => ["1ª série", "2ª série", "3ª série"]
        }
      %>

      <% grouped_classes.each do |group_name, grades| %>

        <tr class="table-secondary">
          <td colspan="4" class="fw-bold text-uppercase class-group">
            <%= group_name %>
          </td>
        </tr>

        <%
          classes =
            @school_classes
              .select { |c| grades.include?(c.grade) }
              .sort_by { |c| [grades.index(c.grade), c.identifier.to_s] }
        %>

        <% classes.each do |school_class| %>

          <tr
            onclick="window.location='<%= school_class_path(school_class) %>'"
            style="cursor: pointer;"
          >

            <td>
              <%= "#{school_class.grade} #{school_class.identifier}" %>
            </td>

            <td>
              <%= school_class.shift %>
            </td>

            <td>
              <%= school_class.students.count %>
            </td>

            <td></td>

          </tr>

        <% end %>

      <% end %>

    </tbody>

  </table>


  <!-- =========================================
       MODAL - LISTA DE FREQUÊNCIA
  ========================================== -->

  <div
    class="modal fade"
    id="frequencyModal"
    tabindex="-1"
    aria-labelledby="frequencyModalLabel"
    aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

      <div class="modal-content">

        <%= form_with model: TestApplication.new,
            url: test_applications_path,
            method: :post,
            local: true do |form| %>


          <!-- CABEÇALHO -->

          <div class="modal-header">

            <h5 class="modal-title" id="frequencyModalLabel">
              Lista de frequência
            </h5>

            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Fechar">
            </button>

          </div>


          <!-- CORPO -->

          <div class="modal-body">

            <div class="row g-3">


              <!-- TIPO DE PROVA -->

              <div class="col-md-6">

                <%= form.label :exam_type,
                    "Tipo de prova",
                    class: "form-label fw-bold" %>

                <%= form.select :exam_type,
                    ["Parcial", "Global"],
                    { prompt: "Selecione..." },
                    class: "form-select",
                    required: true %>

              </div>


              <!-- DATA -->

              <div class="col-md-6">

                <%= form.label :application_date,
                    "Data da aplicação",
                    class: "form-label fw-bold" %>

                <%= form.date_field :application_date,
                    class: "form-control",
                    required: true %>

              </div>


              <!-- COMPONENTE CURRICULAR -->

              <div class="col-md-12">

                <%= form.label :subject_name,
                    "Componente curricular",
                    class: "form-label fw-bold" %>

                <%= form.text_field :subject_name,
                    class: "form-control",
                    placeholder: "Digite o componente curricular",
                    required: true %>

              </div>


              <!-- FISCAL -->

              <div class="col-md-12">

                <%= form.label :invigilator,
                    "Fiscal responsável",
                    class: "form-label fw-bold" %>

                <%= form.text_field :invigilator,
                    class: "form-control",
                    placeholder: "Digite o nome do fiscal" %>

              </div>


              <!-- TURMAS -->

              <div class="col-md-12">

                <label class="form-label fw-bold">
                  Turmas
                </label>


                <!-- TODAS AS TURMAS -->

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="radio"
                    name="class_selection"
                    id="allClasses"
                    value="all"
                    checked>

                  <label
                    class="form-check-label"
                    for="allClasses">

                    Todas as turmas

                  </label>

                </div>


                <!-- SELECIONAR TURMAS -->

                <div class="form-check">

                  <input
                    class="form-check-input"
                    type="radio"
                    name="class_selection"
                    id="selectedClasses"
                    value="selected">

                  <label
                    class="form-check-label"
                    for="selectedClasses">

                    Selecionar turmas

                  </label>

                </div>


                <!-- ÁREA DE SELEÇÃO INDIVIDUAL -->

                <div
                  id="classesSelection"
                  class="mt-3 p-3 border rounded d-none">


                  <div
                    class="d-flex justify-content-between align-items-center mb-2">

                    <strong>
                      Selecionar turmas
                    </strong>


                    <div>

                      <button
                        type="button"
                        class="btn btn-outline-secondary btn-sm"
                        id="selectAllClasses">

                        Selecionar todas

                      </button>


                      <button
                        type="button"
                        class="btn btn-outline-secondary btn-sm"
                        id="clearAllClasses">

                        Limpar seleção

                      </button>

                    </div>

                  </div>


                  <!-- LISTA DE TURMAS -->

                  <div
                    class="border rounded p-2"
                    style="max-height: 250px; overflow-y: auto;">


                    <%
                      grouped_classes = {
                        "Anos Iniciais" => [
                          "1º ano",
                          "2º ano",
                          "3º ano",
                          "4º ano",
                          "5º ano"
                        ],

                        "Anos Finais" => [
                          "6º ano",
                          "7º ano",
                          "8º ano",
                          "9º ano"
                        ],

                        "Ensino Médio" => [
                          "1ª série",
                          "2ª série",
                          "3ª série"
                        ]
                      }
                    %>


                    <% grouped_classes.each do |group_name, grades| %>

                      <div class="mb-3">


                        <div class="fw-bold text-uppercase small mb-1">
                          <%= group_name %>
                        </div>


                        <%
                          classes =
                            @school_classes
                              .select { |c| grades.include?(c.grade) }
                              .sort_by {
                                |c|
                                [
                                  grades.index(c.grade),
                                  c.identifier.to_s
                                ]
                              }
                        %>


                        <% classes.each do |school_class| %>

                          <div class="form-check">


                            <input
                              class="form-check-input class-checkbox"
                              type="checkbox"
                              name="school_class_ids[]"
                              value="<%= school_class.id %>"
                              id="class_<%= school_class.id %>">


                            <label
                              class="form-check-label"
                              for="class_<%= school_class.id %>">

                              <%= "#{school_class.grade} #{school_class.identifier} - #{school_class.shift}" %>

                            </label>


                          </div>

                        <% end %>


                      </div>

                    <% end %>


                  </div>

                </div>

              </div>

            </div>

          </div>


          <!-- RODAPÉ -->

          <div class="modal-footer">

            <button
              type="button"
              class="btn btn-secondary btn-sm"
              data-bs-dismiss="modal">

              Cancelar

            </button>


            <%= form.submit "Gerar lista de frequência",
                class: "btn btn-primary btn-sm" %>

          </div>


        <% end %>

      </div>

    </div>

  </div>

</div>