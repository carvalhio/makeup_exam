<p style="color: green"><%= notice %></p>

<style>
  .school-class-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .school-class-wrapper .table {
    font-size: 13px;
  }

  .school-class-wrapper .table th,
  .school-class-wrapper .table td {
    padding: 1px 10px !important;
  }
</style>

<div class="school-class-wrapper mt-4">

  <!-- CABEÇALHO -->
  <div class="d-flex justify-content-between align-items-center mb-3">

    <div>
      <h1 class="mb-1" style="font-size: 22px;">
        <%= @school_class.grade %> <%= @school_class.identifier %>
      </h1>

      <p class="text-muted mb-0 small">
        <%= @school_class.shift %>
      </p>
    </div>

    <div class="d-flex gap-2">

      <!-- ADICIONAR ALUNO -->
      <button type="button"
              class="btn btn-primary btn-sm"
              data-bs-toggle="modal"
              data-bs-target="#addStudentModal">
        Adicionar aluno
      </button>

      <!-- GERAR FREQUÊNCIA -->
      <button type="button"
              class="btn btn-success btn-sm"
              data-bs-toggle="modal"
              data-bs-target="#frequencyModal">
        Gerar Frequência
      </button>

      <!-- VOLTAR -->
      <%= link_to "Voltar",
          school_classes_path,
          class: "btn btn-primary btn-sm" %>

    </div>
  </div>


  <!-- TABELA DE ALUNOS -->
  <div class="card shadow-sm">

    <div class="card-body p-0">

      <table class="table table-hover table-sm align-middle mb-0 small">

        <thead class="table-dark">
          <tr>
            <th style="width: 20px;" class="text-center">
              Nº
            </th>

            <th>
              Aluno
            </th>
          </tr>
        </thead>

        <tbody>

          <% if @students.any? %>

            <% @students.order(:name).each_with_index do |student, index| %>

              <tr
                id="student_row_<%= student.id %>"
                data-bs-toggle="modal"
                data-bs-target="#editStudentModal<%= student.id %>"
                style="cursor: pointer;"
              >

                <td class="text-center">
                  <%= index + 1 %>
                </td>

                <td>
                  <%= student.name %>

                  <% if student.aee %>
                    <span
                      class="badge bg-warning text-dark ms-1"
                      style="font-size: 9px;"
                    >
                      AEE
                    </span>
                  <% end %>
                </td>

              </tr>

            <% end %>

          <% else %>

            <tr>
              <td
                colspan="2"
                class="text-center text-muted py-4"
              >
                Nenhum aluno cadastrado.
              </td>
            </tr>

          <% end %>

        </tbody>

      </table>

    </div>
  </div>

</div>


<!-- ========================================================= -->
<!-- MODAIS DE EDIÇÃO DOS ALUNOS                              -->
<!-- ========================================================= -->

<% @students.each do |student| %>

  <div
    class="modal fade"
    id="editStudentModal<%= student.id %>"
    tabindex="-1"
    aria-labelledby="editStudentModalLabel<%= student.id %>"
    aria-hidden="true"
  >

    <div
      class="modal-dialog modal-dialog-centered"
      style="max-width: 500px;"
    >

      <div class="modal-content">

        <div class="modal-header py-2">

          <h5
            class="modal-title"
            id="editStudentModalLabel<%= student.id %>"
          >
            Editar aluno
          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Fechar"
          ></button>

        </div>


        <div class="modal-body">

          <!-- FORMULÁRIO DE EDIÇÃO -->
          <%= form_with model: student do |form| %>

            <div class="mb-3">

              <%= form.label :name,
                  "Nome",
                  class: "form-label fw-bold" %>

              <%= form.text_field :name,
                  class: "form-control form-control-sm" %>

            </div>


            <div class="mb-3">

              <%= form.label :school_class_id,
                  "Turma",
                  class: "form-label fw-bold" %>

              <%= form.collection_select(
                    :school_class_id,
                    SchoolClass.all.order(:grade, :identifier),
                    :id,
                    ->(sc) {
                      "#{sc.grade} #{sc.identifier} - #{sc.shift}"
                    },
                    {},
                    class: "form-select form-select-sm"
                  ) %>

            </div>


            <div class="form-check mb-3">

              <%= form.check_box :aee,
                  class: "form-check-input" %>

              <%= form.label :aee,
                  class: "form-check-label" do %>

                AEE

                <small class="text-muted fw-normal">
                  (fará teste adaptado)
                </small>

              <% end %>

            </div>


            <!-- BOTÕES DO FORMULÁRIO DE EDIÇÃO -->
            <div class="d-flex justify-content-end gap-2">

              <button
                type="button"
                class="btn btn-secondary btn-sm"
                data-bs-dismiss="modal"
              >
                Cancelar
              </button>

              <%= form.submit "Salvar",
                  class: "btn btn-primary btn-sm" %>

            </div>

          <% end %>


          <!-- ================================================= -->
          <!-- EXCLUSÃO DO ALUNO                                -->
          <!-- FORA DO FORM_WITH DE EDIÇÃO                      -->
          <!-- ================================================= -->

          <div class="mt-3 pt-3 border-top">

            <%= button_to "Excluir aluno",
                student_path(student),
                method: :delete,
                class: "btn btn-danger btn-sm",
                form: {
                  data: {
                    turbo_confirm: "Tem certeza que deseja excluir este aluno?"
                  }
                } %>

          </div>

        </div>

      </div>

    </div>

  </div>

<% end %>


<!-- ========================================================= -->
<!-- MODAL - ADICIONAR ALUNO                                  -->
<!-- ========================================================= -->

<div
  class="modal fade"
  id="addStudentModal"
  tabindex="-1"
  aria-labelledby="addStudentModalLabel"
  aria-hidden="true"
>

  <div
    class="modal-dialog modal-dialog-centered"
    style="max-width: 500px;"
  >

    <div class="modal-content">

      <div class="modal-header py-2">

        <h5
          class="modal-title"
          id="addStudentModalLabel"
        >
          Adicionar aluno
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Fechar"
        ></button>

      </div>


      <div class="modal-body">

        <%= form_with model: Student.new,
                      url: students_path,
                      method: :post do |form| %>


          <div class="mb-3">

            <%= form.label :name,
                "Nome",
                class: "form-label fw-bold" %>

            <%= form.text_field :name,
                class: "form-control form-control-sm",
                autofocus: true %>

          </div>


          <div class="mb-3">

            <%= form.label :school_class_id,
                "Turma",
                class: "form-label fw-bold" %>

            <%= form.collection_select(
                  :school_class_id,
                  SchoolClass.all.order(:grade, :identifier),
                  :id,
                  ->(school_class) {
                    "#{school_class.grade} #{school_class.identifier} - #{school_class.shift}"
                  },
                  { selected: @school_class.id },
                  class: "form-select form-select-sm"
                ) %>

          </div>


          <div class="form-check mb-3">

            <%= form.check_box :aee,
                class: "form-check-input" %>

            <%= form.label :aee,
                class: "form-check-label" do %>

              AEE

              <small class="text-muted fw-normal">
                (realiza teste adaptado)
              </small>

            <% end %>

          </div>


          <div class="d-flex justify-content-end gap-2">

            <button
              type="button"
              class="btn btn-secondary btn-sm"
              data-bs-dismiss="modal"
            >
              Cancelar
            </button>

            <%= form.submit "Salvar",
                class: "btn btn-primary btn-sm" %>

          </div>


        <% end %>

      </div>

    </div>

  </div>

</div>


<!-- ========================================================= -->
<!-- MODAL - GERAR FREQUÊNCIA                                 -->
<!-- ========================================================= -->

<div
  class="modal fade"
  id="frequencyModal"
  tabindex="-1"
  aria-labelledby="frequencyModalLabel"
  aria-hidden="true"
>

  <div class="modal-dialog modal-lg modal-dialog-centered">

    <div class="modal-content">

      <div class="modal-header">

        <h5
          class="modal-title"
          id="frequencyModalLabel"
        >
          Gerar lista de frequência
        </h5>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Fechar"
        ></button>

      </div>


      <div class="modal-body">

        <%= form_with model: TestApplication.new,
              url: test_applications_path,
              method: :post,
              local: true,
              data: { turbo: false }, 
              html: { target: "_blank" } do |form| %>


          <div class="alert alert-info py-2 mb-3">

            <strong>Turma:</strong>

            <%= @school_class.grade %>
            <%= @school_class.identifier %>
            -
            <%= @school_class.shift %>

          </div>


          <div class="mb-3">

            <label class="form-label fw-bold">
              Tipo de prova
            </label>

            <%= form.select :exam_type,
                ["Parcial", "Global"],
                { prompt: "Selecione..." },
                class: "form-select" %>

          </div>


          <div class="mb-3">

            <label class="form-label fw-bold">
              Data
            </label>

            <%= form.date_field :application_date,
                class: "form-control" %>

          </div>


          <div class="mb-3">

            <label class="form-label fw-bold">
              Componente curricular
            </label>

            <%= form.text_field :subject_name,
                class: "form-control",
                placeholder: "Digite o componente curricular" %>

          </div>


          <div class="mb-3">

            <label class="form-label fw-bold">
              Fiscal responsável
            </label>

            <%= form.text_field :invigilator,
                class: "form-control",
                placeholder: "Digite o nome do fiscal" %>

          </div>


          <div class="mb-3">

            <div class="form-check">

              <%= form.check_box :include_aee,
                  class: "form-check-input" %>

              <%= form.label :include_aee,
                  "Incluir alunos AEE",
                  class: "form-check-label fw-bold" %>

            </div>

            <small class="text-muted">
              Desmarque para gerar a frequência sem os alunos marcados como AEE.
            </small>

          </div>


          <input
            type="hidden"
            name="school_class_ids[]"
            value="<%= @school_class.id %>"
          >

          <input
            type="hidden"
            name="class_selection"
            value="selected"
          >


          <div class="d-flex justify-content-end gap-2">

            <button
              type="button"
              class="btn btn-secondary btn-sm"
              data-bs-dismiss="modal"
            >
              Cancelar
            </button>

            <button
              type="submit"
              class="btn btn-success btn-sm"
            >
              Gerar lista de frequência
            </button>

          </div>


        <% end %>

      </div>

    </div>

  </div>

</div>


<!-- ========================================================= -->
<!-- TOASTS                                                   -->
<!-- ========================================================= -->

<div
  id="toasts"
  class="toast-container position-fixed top-0 end-0 p-3"
  style="z-index: 9999;"
></div>


<script>

  // Fecha qualquer modal aberto quando o formulário tiver sucesso

  document.addEventListener("turbo:submit-end", (event) => {

    if (event.detail.success) {

      const modalEl = document.querySelector(".modal.show");

      if (modalEl) {

        const modal =
          bootstrap.Modal.getInstance(modalEl) ||
          bootstrap.Modal.getOrCreateInstance(modalEl);

        modal.hide();

        setTimeout(() => {

          document
            .querySelectorAll(".modal-backdrop")
            .forEach(el => el.remove());

          document.body.classList.remove("modal-open");
          document.body.style = "";

        }, 200);

      }

    }

  });

</script>

