<div class="frequency-pdf">

  <%
    levels = {
      "Anos Iniciais" => ["1º", "2º", "3º", "4º", "5º"],
      "Anos Finais"   => ["6º", "7º", "8º"],
      "Ensino Médio"  => ["9º", "1ª", "2ª", "3ª"]
    }

    pages = []

    levels.each do |level_name, grades|
      ["Manhã", "Tarde"].each do |shift|
        pages << [level_name, grades, shift]
      end
    end
  %>

  <% pages.each_with_index do |(level_name, grades, shift), page_index| %>

    <%
      school_classes = @test_application.school_classes
        .where(shift: shift)
        .where(grade: grades)
        .includes(:students)
        .sort_by { |school_class| [school_class.grade.to_s, school_class.identifier.to_s] }

      students_by_class = school_classes.map do |school_class|
        students = school_class.students
          .where(aee: true)
          .order(:name)

        [school_class, students]
      end.reject { |school_class, students| students.empty? }

      next if students_by_class.empty?

      students = students_by_class.flat_map do |school_class, class_students|
        class_students.map { |student| [school_class, student] }
      end
    %>

    <div class="frequency-page">

      <!-- CABEÇALHO -->

      <div class="frequency-header">

        <div class="frequency-logo">
          <img
            src="<%= wicked_pdf_asset_base64('logo.png') %>"
            style="width: 100%; height: auto;"
          />
        </div>

        <%
          exam_type = @test_application.exam_type == "Global" ? "globais" : "parciais"
        %>

        <h1 class="turma-titulo">
          Lista de frequência p/ testes <%= exam_type %> adaptados -
          <%= @test_application.stage %> etapa -
          <%= shift %>
        </h1>

        <div class="frequency-info">

          <div class="info-item">
            <strong>Data:</strong>
            <%= @test_application.application_date.strftime("%d/%m/%Y") %>
          </div>

          <div class="info-item">
            <strong>Componentes curriculares:</strong>
            <%= @test_application.subject_name.presence || "________________________" %>
          </div>

          <div class="fiscal-item">
            <strong>Fiscal responsável:</strong>

            <% if @test_application.invigilator.present? %>

              <span class="fiscal-name">
                <%= @test_application.invigilator %>
              </span>

              <span class="fiscal-blank"></span>

            <% else %>

              <span class="fiscal-blank fiscal-blank--empty"></span>

            <% end %>

          </div>

        </div>

      </div>

      <!-- TABELA DE ALUNOS -->

     <table class="frequency-table">
        <colgroup>
          <col style="width: 60px;">
          <col class="student-column">
          <col class="signature-column">
        </colgroup>

        <thead>
          <tr>
            <th class="number-column">Turma</th>
            <th class="student-column">Aluno(a)</th>
            <th class="signature-column">Assinatura</th>
          </tr>
        </thead>

        <tbody>

          <% students.each do |school_class, student| %>

            <tr>

              <td style="width: 60px; white-space: nowrap; text-align: center;">
                <%= "#{school_class.grade} #{school_class.identifier}" %>
              </td>

              <td class="student-column">
                <%= student.name %>
              </td>

              <td class="signature-column"></td>

            </tr>

          <% end %>

        </tbody>

      </table>

      <!-- ESPAÇO ENTRE A TABELA E AS OBSERVAÇÕES -->

      <div class="frequency-spacer"></div>

      <!-- OBSERVAÇÕES / CONSIDERAÇÕES -->

      <div class="observations-wrapper">

        <table class="observations-table">

          <tr>
            <th>OBSERVAÇÕES / CONSIDERAÇÕES</th>
          </tr>

          <% 4.times do %>
            <tr>
              <td></td>
            </tr>
          <% end %>

        </table>

      </div>

    </div>

    <!-- QUEBRA DE PÁGINA -->

    <% unless page_index == pages.length - 1 %>
      <div class="frequency-page-break"></div>
    <% end %>

  <% end %>

</div>